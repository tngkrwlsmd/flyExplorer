#include <windows.h>
#include "../../app/winui/product_version.h"

IDI_SETUP_ICON ICON "../../app/winui/Assets/flyExplorer.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FLYEXPLORER_VERSION_COMMA
 PRODUCTVERSION FLYEXPLORER_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", FLYEXPLORER_COMPANY_NAME "\0"
            VALUE "FileDescription", "flyExplorer Setup\0"
            VALUE "FileVersion", FLYEXPLORER_VERSION_STRING "\0"
            VALUE "InternalName", "flyExplorer-Setup-x64\0"
            VALUE "LegalCopyright", FLYEXPLORER_LEGAL_COPYRIGHT "\0"
            VALUE "OriginalFilename", "flyExplorer-Setup-x64.exe\0"
            VALUE "ProductName", "flyExplorer Setup\0"
            VALUE "ProductVersion", FLYEXPLORER_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
