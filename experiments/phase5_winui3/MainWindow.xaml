<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FlyExplorerWinUI3NavPoC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Phase 5 WinUI 3 Navigation PoC">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel Margin="16" Spacing="12" VerticalAlignment="Top">
            <TextBlock Text="Real WinUI 3 / Fluent navigation controls" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton" Content="&#x2190;" ToolTipService.ToolTip="Back" Click="OnBackClicked" MinWidth="48" Height="40"/>
                <Button x:Name="ForwardButton" Content="&#x2192;" ToolTipService.ToolTip="Forward" Click="OnForwardClicked" MinWidth="48" Height="40"/>
                <Button x:Name="UpButton" Content="&#x2191;" ToolTipService.ToolTip="Up" Click="OnUpClicked" MinWidth="48" Height="40"/>
                <TextBox x:Name="AddressBox" MinWidth="470" Height="40" PlaceholderText="Enter folder path" KeyDown="OnAddressKeyDown"
                         AutomationProperties.Name="Folder address"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <TextBlock Text="Isolated demo: filesystem only. NOT connected to flyExplorer's ExplorerCtrl." Opacity="0.64"/>
        </StackPanel>
    </Grid>
</Window>
