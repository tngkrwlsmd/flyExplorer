<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FlyExplorerWinUIShell.ShellHeader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Grid Padding="16,8,16,8" ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock x:Name="ShellHeading" Text="flyExplorer"
                           FontSize="21" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="flyExplorer 메인 화면"/>
                <Border CornerRadius="6" Padding="8,3"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="WINUI 3" FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="전환 미리보기"
                           VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                        VerticalAlignment="Center">
                <TextBlock x:Name="ThemeStateText" Text="테마: 시스템"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="현재 화면 테마"/>
                <ComboBox x:Name="ThemePicker" Width="115" Header=""
                          SelectedIndex="0"
                          SelectionChanged="OnThemeSelectionChanged"
                          AutomationProperties.Name="화면 테마 선택">
                    <ComboBoxItem Content="시스템"/>
                    <ComboBoxItem Content="라이트"/>
                    <ComboBoxItem Content="다크"/>
                </ComboBox>
            </StackPanel>
        </Grid>
</UserControl>
