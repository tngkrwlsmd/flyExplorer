<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FlyExplorerWinUIShell.NavigationSidebar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
            <Border CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="탐색" FontSize="15" FontWeight="SemiBold" Margin="6,9,0,8"/>
                    <Button x:Uid="HomeButton" x:Name="HomeButton" Content="홈" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OnHomeClicked" AutomationProperties.Name="홈 폴더로 이동"/>
                    <Button x:Uid="DocumentsButton" x:Name="DocumentsButton" Content="문서" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Click="OnDocumentsClicked"/>
                    <Button x:Uid="DownloadsButton" x:Name="DownloadsButton" Content="다운로드" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Click="OnDownloadsClicked"/>
                    <Button x:Uid="ThisPCButton" x:Name="ThisPCButton" Content="내 PC" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Click="OnThisPCClicked"
                            AutomationProperties.Name="내 PC로 이동"/>
                    <TextBlock Text="독립 Shell 작업자 · 파일 변경 감지"
                               TextWrapping="Wrap" Opacity="0.60" FontSize="12" Margin="6,14,6,0"/>
                </StackPanel>
            </Border>
</UserControl>
