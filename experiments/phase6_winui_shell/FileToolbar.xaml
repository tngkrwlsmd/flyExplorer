<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FlyExplorerWinUIShell.FileToolbar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Grid Padding="14,3,14,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="파일 작업" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="FileNameBox" Grid.Column="1"
                     PlaceholderText="새 이름을 입력하세요"
                     AutomationProperties.Name="새 폴더 또는 새 파일 이름"/>
            <Button x:Name="CreateFolderButton" Grid.Column="2"
                    Content="새 폴더" Click="OnCreateFolder"
                    AutomationProperties.Name="현재 폴더에 새 폴더 만들기"/>
            <Button x:Name="RenameButton" Grid.Column="3"
                    Content="이름 변경" Click="OnRenameSelected"
                    AutomationProperties.Name="선택된 파일 또는 폴더 이름 변경"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal"
                        Spacing="6" HorizontalAlignment="Right">
                <Button x:Uid="CopyAction" x:Name="CopyButton"
                    Content="복사 →" Click="OnCopy"
                    AutomationProperties.Name="선택한 항목을 반대쪽 창으로 복사"/>
                <Button x:Uid="MoveAction" x:Name="MoveButton"
                    Content="이동 →" Click="OnMove"
                    AutomationProperties.Name="선택한 항목을 반대쪽 창으로 이동"/>
                <Button x:Uid="RecycleAction" x:Name="RecycleButton"
                    Content="휴지통" Click="OnRecycle"
                    AutomationProperties.Name="선택한 항목을 확인 후 휴지통으로 보내기"/>
                <Button x:Uid="CancelAction" x:Name="CancelButton"
                    Content="취소" Click="OnCancel" IsEnabled="False"
                    AutomationProperties.Name="진행 중인 Shell 파일 작업 취소"/>
                <ComboBox x:Name="SortPicker" Header="정렬" Width="112"
                    SelectedIndex="0" SelectionChanged="OnSortChanged"
                    AutomationProperties.Name="현재 창 파일 정렬 방식">
                    <ComboBoxItem Content="이름 ↑"/>
                    <ComboBoxItem Content="이름 ↓"/>
                    <ComboBoxItem Content="크기 ↓"/>
                    <ComboBoxItem Content="수정 날짜 ↓"/>
                </ComboBox>
                <ProgressBar x:Name="OperationProgress" Width="100"
                    Height="18" Minimum="0" Maximum="100" Value="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="파일 작업 진행률"/>
            </StackPanel>
        </Grid>
</UserControl>
