<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FlyExplorerWinUIShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlyExplorerWinUIShell"
    Title="flyExplorer - WinUI 3 전환 미리보기">
    <Grid x:Name="RootShell"
          Background="Transparent"
          SizeChanged="OnShellSizeChanged">
    <Grid.Resources>
        <Style x:Key="ExplorerIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ExplorerListItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="ExplorerPaneTitleStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:ShellHeader x:Name="HeaderView" Grid.Row="0"/>
        <local:FileToolbar x:Name="ToolbarView" Grid.Row="1"/>
        <Grid Grid.Row="2" Padding="12,4,12,8" ColumnSpacing="7"
              AutomationProperties.Name="&#xD0D0;&#xC0C9; &#xBC0F; &#xC8FC;&#xC18C; &#xD45C;&#xC2DC;&#xC904;">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                <Button x:Name="BackButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xB4A4;&#xB85C;" Click="OnBackClicked"
                        AutomationProperties.Name="&#xB4A4;&#xB85C;">
                    <FontIcon Glyph="&#xE72B;" FontSize="15"/>
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xC55E;&#xC73C;&#xB85C;" Click="OnForwardClicked"
                        AutomationProperties.Name="&#xC55E;&#xC73C;&#xB85C;">
                    <FontIcon Glyph="&#xE72A;" FontSize="15"/>
                </Button>
                <Button x:Name="UpButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xC0C1;&#xC704; &#xD3F4;&#xB354;" Click="OnUpClicked"
                        AutomationProperties.Name="&#xC0C1;&#xC704; &#xD3F4;&#xB354;">
                    <FontIcon Glyph="&#xE74A;" FontSize="15"/>
                </Button>
            </StackPanel>
            <TextBox x:Name="AddressBox" Grid.Column="1" Height="34"
                     PlaceholderText="&#xD3F4;&#xB354; &#xACBD;&#xB85C;&#xB97C; &#xC785;&#xB825;&#xD558;&#xC138;&#xC694;"
                     KeyDown="OnAddressKeyDown"
                     AutomationProperties.Name="&#xD604;&#xC7AC; &#xD3F4;&#xB354; &#xC8FC;&#xC18C;"/>
            <TextBox x:Name="QuickSearchBox" Grid.Column="2" Height="34"
                     PlaceholderText="&#xD604;&#xC7AC; &#xD3F4;&#xB354; &#xAC80;&#xC0C9;"
                     KeyDown="OnQuickSearchKeyDown"
                     AutomationProperties.Name="&#xD604;&#xC7AC; &#xD3F4;&#xB354; &#xAC80;&#xC0C9;&#xC5B4;"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                <Button x:Name="NewTabButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xC0C8; &#xD0ED;" Click="OnNewTabClicked"
                        AutomationProperties.Name="&#xC0C8; &#xD0ED;">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                </Button>
                <Button x:Name="CloseTabButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xD0ED; &#xB2EB;&#xAE30;" Click="OnCloseTabClicked"
                        AutomationProperties.Name="&#xD604;&#xC7AC; &#xD0ED; &#xB2EB;&#xAE30;">
                    <FontIcon Glyph="&#xE711;" FontSize="14"/>
                </Button>
                <Button x:Name="SplitButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xB4C0;&#xC5BC; &#xD328;&#xB110; &#xC804;&#xD658;"
                        Click="OnSplitClicked"
                        AutomationProperties.Name="&#xB4C0;&#xC5BC; &#xD328;&#xB110; &#xC804;&#xD658;">
                    <FontIcon Glyph="&#xE73F;" FontSize="14"/>
                </Button>
                <Button x:Name="WorkspacePanelButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xC791;&#xC5C5; &#xACF5;&#xAC04;"
                        AutomationProperties.Name="&#xC791;&#xC5C5; &#xACF5;&#xAC04; &#xC5F4;&#xAE30;"
                        Click="OnToggleWorkspaces">
                    <FontIcon Glyph="&#xE821;" FontSize="14"/>
                </Button>
                <Button x:Name="SearchPanelButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xACE0;&#xAE09; &#xAC80;&#xC0C9;"
                        AutomationProperties.Name="&#xD30C;&#xC77C; &#xAC80;&#xC0C9; &#xC5F4;&#xAE30;"
                        Click="OnToggleSearch">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" x:Name="WorkspacePanel" Visibility="Collapsed"
                    Orientation="Vertical" Spacing="7" Padding="14,3,14,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="이름 있는 작업 공간:" VerticalAlignment="Center"/>
                <TextBox x:Name="WorkspaceFileBox" Width="355"
                         PlaceholderText=".fxworkspace 파일 전체 경로"
                         AutomationProperties.Name="작업 공간 파일 경로"/>
                <Button x:Uid="SaveWorkspaceButton" x:Name="SaveWorkspaceButton" Content="새로 저장"
                        Click="OnSaveWorkspace" AutomationProperties.Name="새 작업 공간 저장"/>
                <Button x:Uid="OpenWorkspaceButton" x:Name="OpenWorkspaceButton" Content="새 창에서 열기"
                        Click="OnOpenWorkspace" AutomationProperties.Name="작업 공간을 새 창에서 열기"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Button x:Uid="SaveSessionAction" x:Name="SaveSessionButton" Content="현재 세션 기억"
                        Click="OnSavePrivateSession"
                        AutomationProperties.Name="현재 폴더 탭 및 화면 설정을 개인 프로필에 저장"/>
                <Button x:Uid="RestoreSessionAction" x:Name="RestoreSessionButton" Content="저장된 세션 복원"
                        Click="OnRestorePrivateSession"
                        AutomationProperties.Name="저장된 개인 탐색 세션 불러오기"/>
                <Button x:Uid="ClearSessionAction" x:Name="ClearSessionButton" Content="기억 삭제"
                        Click="OnClearPrivateSession"
                        AutomationProperties.Name="저장된 개인 탐색 세션 지우기"/>
                <TextBlock Text="기존 파일은 덮어쓰지 않습니다"
                           Opacity="0.65" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="4" x:Name="SearchPanel" Visibility="Collapsed"
                    Spacing="5" Padding="14,3,14,5">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBox x:Name="SearchScopeBox" Width="315"
                         PlaceholderText="검색할 폴더의 전체 경로"
                         AutomationProperties.Name="검색 폴더 전체 경로"/>
                <TextBox x:Name="SearchTermBox" Width="155"
                         PlaceholderText="파일 이름에 포함될 단어"
                         AutomationProperties.Name="검색어"/>
                <CheckBox x:Name="SearchRememberBox" IsChecked="False"
                          Content="검색 위치 기억(선택)"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="최근 검색 위치 저장 선택"/>
                <Button x:Uid="SearchRunButton" x:Name="SearchRunButton" Content="파일 찾기"
                        Click="OnRunSearch" AutomationProperties.Name="파일 이름 검색 실행"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="최근 검색 위치:" VerticalAlignment="Center"/>
                <TextBlock x:Name="RecentCountText" Text="저장 0개" VerticalAlignment="Center"
                           AutomationProperties.Name="최근 검색 위치 수"/>
                <ComboBox x:Name="SearchRecentBox" Width="350"
                          PlaceholderText="저장된 검색 위치 선택"
                          SelectionChanged="OnSelectSearchRecent"
                          AutomationProperties.Name="최근 검색 위치"/>
                <Button x:Uid="SearchClearButton" x:Name="SearchClearButton" Content="최근 기록 지우기"
                        Click="OnClearSearchRecent"
                        AutomationProperties.Name="최근 검색 위치 지우기"/>
                <TextBlock x:Name="SearchCountText" Text="제한된 파일 이름 검색 · 파일 변경 없음"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="검색 결과 요약"/>
            </StackPanel>
            <ListView x:Name="SearchMatches" Height="64"
                      AutomationProperties.Name="일치하는 파일 경로"/>
        </StackPanel>
        <Grid Grid.Row="5" Padding="10,0,10,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="188"/>
                <ColumnDefinition x:Name="PrimaryColumn" Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition x:Name="SecondaryColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <local:NavigationSidebar x:Name="SidebarView" Grid.Column="0"/>
            <Border x:Name="PrimaryPane" Grid.Column="1"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="PrimaryPaneTitle" Content="&#xC67C;&#xCABD; &#xCC3D;"
                        Style="{StaticResource ExplorerPaneTitleStyle}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="&#xC67C;&#xCABD; &#xCC3D; &#xD65C;&#xC131;&#xD654;" Click="OnActivateLeft"
                        Margin="2,1,0,2"/>
                <TextBox x:Name="LeftNameFilterBox" Grid.Row="0"
                         HorizontalAlignment="Right" Width="125"
                         MaxLength="64" TextChanged="OnNameFilterChanged"
                         PlaceholderText="&#xC774;&#xB984; &#xD544;&#xD130;"
                         AutomationProperties.Name="&#xC67C;&#xCABD; &#xD30C;&#xC77C; &#xC774;&#xB984; &#xD544;&#xD130;"/>
                <TabView x:Name="LeftTabs" Grid.Row="1" Height="40"
                         IsAddTabButtonVisible="False" CanDragTabs="False"
                         TabWidthMode="SizeToContent" SelectionChanged="OnLeftTabSelectionChanged"
                         AutomationProperties.Name="왼쪽 폴더 탭"/>
                <Grid Grid.Row="2" Height="31" Margin="6,0,6,1"
                      AutomationProperties.Name="&#xC67C;&#xCABD; &#xD30C;&#xC77C; &#xBAA9;&#xB85D; &#xC5F4; &#xBA38;&#xB9AC;&#xAE00;">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftNameHeaderColumn" Width="168"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="155"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="4,0,6,0">
                        <TextBlock Text="&#xC774;&#xB984;" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Spacing="3"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Slider x:Name="LeftNameWidthSlider" Minimum="120" Maximum="320"
                                    Value="168" StepFrequency="16" Width="46"
                                    ValueChanged="OnNameColumnWidthChanged"
                                    ToolTipService.ToolTip="&#xC774;&#xB984; &#xC5F4; &#xB108;&#xBE44;"
                                    AutomationProperties.Name="&#xC67C;&#xCABD; &#xC774;&#xB984; &#xC5F4; &#xB108;&#xBE44; &#xC870;&#xC808;"/>
                            <Button x:Name="LeftLoadMoreButton" Content="+160"
                                    Visibility="Collapsed" MinWidth="46" Height="25"
                                    Padding="5,0" Click="OnLoadMoreFiles"
                                    ToolTipService.ToolTip="&#xB2E4;&#xC74C; 160&#xAC1C; &#xD45C;&#xC2DC;"
                                    AutomationProperties.Name="&#xC67C;&#xCABD; &#xD30C;&#xC77C; 160&#xAC1C; &#xB354; &#xD45C;&#xC2DC;"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="&#xC720;&#xD615;" Margin="5,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="&#xD06C;&#xAE30;" Margin="5,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="3" Text="&#xC218;&#xC815; &#xB0A0;&#xC9DC;" Margin="5,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </Grid>
                <ListView x:Name="LeftFiles" Grid.Row="3" IsDoubleTapEnabled="True"
                          ItemContainerStyle="{StaticResource ExplorerListItemStyle}"
                           SelectionMode="Multiple" DoubleTapped="OnLeftFileDoubleTapped"
                          KeyDown="OnLeftFileKeyDown" RightTapped="OnFileRightTapped"
                          AllowDrop="True" CanDragItems="True" CanReorderItems="False"
                          DragOver="OnFileDragOver" Drop="OnFileDrop"
                          DragItemsStarting="OnFileDragItemsStarting"
                          AutomationProperties.Name="왼쪽 폴더 내용">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="복사" Click="OnCopySelected"/>
                            <MenuFlyoutItem Text="이동" Click="OnMoveSelected"/>
                            <MenuFlyoutItem Text="이름 변경" Click="OnRenameSelected"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Windows 클립보드로 복사"
                                Click="OnWindowsCopy"/>
                            <MenuFlyoutItem Text="Windows 클립보드로 잘라내기"
                                Click="OnWindowsCut"/>
                            <MenuFlyoutItem Text="Windows 클립보드에서 붙여넣기"
                                Click="OnWindowsPaste"/>
                            <MenuFlyoutItem Text="휴지통" Click="OnRecycleSelected"/>
                            <MenuFlyoutItem Text="Windows &#xD655;&#xC7A5; &#xCEE8;&#xD14D;&#xC2A4;&#xD2B8; &#xBA54;&#xB274;"
                            AutomationProperties.Name="Windows Shell isolated context menu"
                            Click="OnExternalWindowsContextMenu"/>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>
                </Grid>
            </Border>
            <Border x:Name="PaneDivider" Grid.Column="2" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
            <Border x:Name="SecondaryPane" Grid.Column="3"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="SecondaryPaneTitle" Content="&#xC624;&#xB978;&#xCABD; &#xCC3D;"
                        Style="{StaticResource ExplorerPaneTitleStyle}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="&#xC624;&#xB978;&#xCABD; &#xCC3D; &#xD65C;&#xC131;&#xD654;" Click="OnActivateRight"
                        Margin="2,1,0,2"/>
                <TextBox x:Name="RightNameFilterBox" Grid.Row="0"
                         HorizontalAlignment="Right" Width="125"
                         MaxLength="64" TextChanged="OnNameFilterChanged"
                         PlaceholderText="&#xC774;&#xB984; &#xD544;&#xD130;"
                         AutomationProperties.Name="&#xC624;&#xB978;&#xCABD; &#xD30C;&#xC77C; &#xC774;&#xB984; &#xD544;&#xD130;"/>
                <TabView x:Name="RightTabs" Grid.Row="1" Height="40"
                         IsAddTabButtonVisible="False" CanDragTabs="False"
                         TabWidthMode="SizeToContent" SelectionChanged="OnRightTabSelectionChanged"
                         AutomationProperties.Name="오른쪽 폴더 탭"/>
                <Grid Grid.Row="2" Height="31" Margin="6,0,6,1"
                      AutomationProperties.Name="&#xC624;&#xB978;&#xCABD; &#xD30C;&#xC77C; &#xBAA9;&#xB85D; &#xC5F4; &#xBA38;&#xB9AC;&#xAE00;">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="RightNameHeaderColumn" Width="168"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="155"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="4,0,6,0">
                        <TextBlock Text="&#xC774;&#xB984;" VerticalAlignment="Center"
                                   FontWeight="SemiBold" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Spacing="3"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Slider x:Name="RightNameWidthSlider" Minimum="120" Maximum="320"
                                    Value="168" StepFrequency="16" Width="46"
                                    ValueChanged="OnNameColumnWidthChanged"
                                    ToolTipService.ToolTip="&#xC774;&#xB984; &#xC5F4; &#xB108;&#xBE44;"
                                    AutomationProperties.Name="&#xC624;&#xB978;&#xCABD; &#xC774;&#xB984; &#xC5F4; &#xB108;&#xBE44; &#xC870;&#xC808;"/>
                            <Button x:Name="RightLoadMoreButton" Content="+160"
                                    Visibility="Collapsed" MinWidth="46" Height="25"
                                    Padding="5,0" Click="OnLoadMoreFiles"
                                    ToolTipService.ToolTip="&#xB2E4;&#xC74C; 160&#xAC1C; &#xD45C;&#xC2DC;"
                                    AutomationProperties.Name="&#xC624;&#xB978;&#xCABD; &#xD30C;&#xC77C; 160&#xAC1C; &#xB354; &#xD45C;&#xC2DC;"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="&#xC720;&#xD615;" Margin="5,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="&#xD06C;&#xAE30;" Margin="5,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="3" Text="&#xC218;&#xC815; &#xB0A0;&#xC9DC;" Margin="5,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </Grid>
                <ListView x:Name="RightFiles" Grid.Row="3" IsDoubleTapEnabled="True"
                          ItemContainerStyle="{StaticResource ExplorerListItemStyle}"
                           SelectionMode="Multiple" DoubleTapped="OnRightFileDoubleTapped"
                          KeyDown="OnRightFileKeyDown" RightTapped="OnFileRightTapped"
                          AllowDrop="True" CanDragItems="True" CanReorderItems="False"
                          DragOver="OnFileDragOver" Drop="OnFileDrop"
                          DragItemsStarting="OnFileDragItemsStarting"
                          AutomationProperties.Name="오른쪽 폴더 내용">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="복사" Click="OnCopySelected"/>
                            <MenuFlyoutItem Text="이동" Click="OnMoveSelected"/>
                            <MenuFlyoutItem Text="이름 변경" Click="OnRenameSelected"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Windows 클립보드로 복사"
                                Click="OnWindowsCopy"/>
                            <MenuFlyoutItem Text="Windows 클립보드로 잘라내기"
                                Click="OnWindowsCut"/>
                            <MenuFlyoutItem Text="Windows 클립보드에서 붙여넣기"
                                Click="OnWindowsPaste"/>
                            <MenuFlyoutItem Text="휴지통" Click="OnRecycleSelected"/>
                            <MenuFlyoutItem Text="Windows &#xD655;&#xC7A5; &#xCEE8;&#xD14D;&#xC2A4;&#xD2B8; &#xBA54;&#xB274;"
                            AutomationProperties.Name="Windows Shell isolated context menu"
                            Click="OnExternalWindowsContextMenu"/>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>
                </Grid>
            </Border>
        </Grid>
        <local:StatusFooter x:Name="FooterView" Grid.Row="6"/>
    </Grid>
</Window>
