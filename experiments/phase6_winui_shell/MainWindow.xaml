<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FlyExplorerWinUIShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlyExplorerWinUIShell"
    Title="flyExplorer - WinUI 3 전환 미리보기">
    <Grid x:Name="RootShell"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:ShellHeader x:Name="HeaderView" Grid.Row="0"/>
        <Grid Grid.Row="1" Padding="14,8,14,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                <Button x:Uid="BackButton" x:Name="BackButton" Content="&#x2190;" Height="38" MinWidth="42" ToolTipService.ToolTip="뒤로" Click="OnBackClicked"/>
                <Button x:Uid="ForwardButton" x:Name="ForwardButton" Content="&#x2192;" Height="38" MinWidth="42" ToolTipService.ToolTip="앞으로" Click="OnForwardClicked"/>
                <Button x:Uid="UpButton" x:Name="UpButton" Content="&#x2191;" Height="38" MinWidth="42" ToolTipService.ToolTip="상위 폴더" Click="OnUpClicked"/>
            </StackPanel>
            <TextBox x:Name="AddressBox" Grid.Column="1" Height="38"
                     PlaceholderText="폴더 경로를 입력하세요" KeyDown="OnAddressKeyDown"
                     AutomationProperties.Name="현재 폴더 주소"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button x:Uid="NewTabButton" x:Name="NewTabButton" Content="새 탭" Height="38" Click="OnNewTabClicked"/>
                <Button x:Uid="CloseTabButton" x:Name="CloseTabButton" Content="탭 닫기" Height="38" Click="OnCloseTabClicked"/>
                <Button x:Name="SplitButton" Content="단일 창" Height="38" Click="OnSplitClicked"/>
                <Button x:Uid="WorkspacePanelButton" x:Name="WorkspacePanelButton" Content="작업 공간" Height="38"
                        AutomationProperties.Name="작업 공간 열기"
                        Click="OnToggleWorkspaces"/>
                <Button x:Uid="SearchPanelButton" x:Name="SearchPanelButton" Content="검색" Height="38"
                        AutomationProperties.Name="파일 검색 열기"
                        Click="OnToggleSearch"/>
            </StackPanel>
        </Grid>

        <local:FileToolbar x:Name="ToolbarView" Grid.Row="2"/>
        <StackPanel Grid.Row="3" x:Name="WorkspacePanel" Visibility="Collapsed"
                    Orientation="Vertical" Spacing="7" Padding="14,3,14,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="이름 있는 작업 공간:" VerticalAlignment="Center"/>
                <TextBox x:Name="WorkspaceFileBox" Width="355"
                         PlaceholderText=".fxworkspace 파일 전체 경로"
                         AutomationProperties.Name="작업 공간 파일 경로"/>
                <Button x:Uid="SaveWorkspaceButton" x:Name="SaveWorkspaceButton" Content="새로 저장"
                        Click="OnSaveWorkspace" AutomationProperties.Name="새 작업 공간 저장"/>
                <Button x:Uid="OpenWorkspaceButton" x:Name="OpenWorkspaceButton" Content="새 창에서 열기"
                        Click="OnOpenWorkspace" AutomationProperties.Name="작업 공간을 새 창에서 열기"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Button x:Uid="SaveSessionAction" x:Name="SaveSessionButton" Content="현재 세션 기억"
                        Click="OnSavePrivateSession"
                        AutomationProperties.Name="현재 폴더 탭 및 화면 설정을 개인 프로필에 저장"/>
                <Button x:Uid="RestoreSessionAction" x:Name="RestoreSessionButton" Content="저장된 세션 복원"
                        Click="OnRestorePrivateSession"
                        AutomationProperties.Name="저장된 개인 탐색 세션 불러오기"/>
                <Button x:Uid="ClearSessionAction" x:Name="ClearSessionButton" Content="기억 삭제"
                        Click="OnClearPrivateSession"
                        AutomationProperties.Name="저장된 개인 탐색 세션 지우기"/>
                <TextBlock Text="기존 파일은 덮어쓰지 않습니다"
                           Opacity="0.65" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="4" x:Name="SearchPanel" Visibility="Collapsed"
                    Spacing="5" Padding="14,3,14,5">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBox x:Name="SearchScopeBox" Width="315"
                         PlaceholderText="검색할 폴더의 전체 경로"
                         AutomationProperties.Name="검색 폴더 전체 경로"/>
                <TextBox x:Name="SearchTermBox" Width="155"
                         PlaceholderText="파일 이름에 포함될 단어"
                         AutomationProperties.Name="검색어"/>
                <CheckBox x:Name="SearchRememberBox" IsChecked="False"
                          Content="검색 위치 기억(선택)"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="최근 검색 위치 저장 선택"/>
                <Button x:Uid="SearchRunButton" x:Name="SearchRunButton" Content="파일 찾기"
                        Click="OnRunSearch" AutomationProperties.Name="파일 이름 검색 실행"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="최근 검색 위치:" VerticalAlignment="Center"/>
                <TextBlock x:Name="RecentCountText" Text="저장 0개" VerticalAlignment="Center"
                           AutomationProperties.Name="최근 검색 위치 수"/>
                <ComboBox x:Name="SearchRecentBox" Width="350"
                          PlaceholderText="저장된 검색 위치 선택"
                          SelectionChanged="OnSelectSearchRecent"
                          AutomationProperties.Name="최근 검색 위치"/>
                <Button x:Uid="SearchClearButton" x:Name="SearchClearButton" Content="최근 기록 지우기"
                        Click="OnClearSearchRecent"
                        AutomationProperties.Name="최근 검색 위치 지우기"/>
                <TextBlock x:Name="SearchCountText" Text="제한된 파일 이름 검색 · 파일 변경 없음"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="검색 결과 요약"/>
            </StackPanel>
            <ListView x:Name="SearchMatches" Height="64"
                      AutomationProperties.Name="일치하는 파일 경로"/>
        </StackPanel>
        <Grid Grid.Row="5" Padding="10,0,10,0" ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition x:Name="PrimaryColumn" Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition x:Name="SecondaryColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <local:NavigationSidebar x:Name="SidebarView" Grid.Column="0"/>
            <Grid x:Name="PrimaryPane" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="PrimaryPaneTitle" Content="왼쪽 창" HorizontalAlignment="Left"
                        AutomationProperties.Name="왼쪽 창 활성화" Click="OnActivateLeft"
                        Margin="0,0,0,3"/>
                <TabView x:Name="LeftTabs" Grid.Row="1" Height="45"
                         IsAddTabButtonVisible="False" CanDragTabs="False"
                         TabWidthMode="SizeToContent" SelectionChanged="OnLeftTabSelectionChanged"
                         AutomationProperties.Name="왼쪽 폴더 탭"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5"
                            AutomationProperties.Name="왼쪽 파일 목록 열 조절">
                    <TextBlock Text="이름 열 너비" VerticalAlignment="Center"/>
                    <Slider x:Name="LeftNameWidthSlider" Minimum="120" Maximum="320"
                            Value="168" StepFrequency="16" Width="92"
                            ValueChanged="OnNameColumnWidthChanged"
                            AutomationProperties.Name="왼쪽 이름 열 너비 조절"/>
                    <TextBlock Text="이름 | Windows 유형 | 크기 | 수정 날짜"
                               VerticalAlignment="Center" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ListView x:Name="LeftFiles" Grid.Row="3" IsDoubleTapEnabled="True"
                          SelectionMode="Multiple" DoubleTapped="OnLeftFileDoubleTapped"
                          KeyDown="OnLeftFileKeyDown" RightTapped="OnFileRightTapped"
                          AllowDrop="True" CanDragItems="True" CanReorderItems="False"
                          DragOver="OnFileDragOver" Drop="OnFileDrop"
                          DragItemsStarting="OnFileDragItemsStarting"
                          AutomationProperties.Name="왼쪽 폴더 내용">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="복사" Click="OnCopySelected"/>
                            <MenuFlyoutItem Text="이동" Click="OnMoveSelected"/>
                            <MenuFlyoutItem Text="이름 변경" Click="OnRenameSelected"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Windows 클립보드로 복사"
                                Click="OnWindowsCopy"/>
                            <MenuFlyoutItem Text="Windows 클립보드로 잘라내기"
                                Click="OnWindowsCut"/>
                            <MenuFlyoutItem Text="Windows 클립보드에서 붙여넣기"
                                Click="OnWindowsPaste"/>
                            <MenuFlyoutItem Text="휴지통" Click="OnRecycleSelected"/>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>
            </Grid>
            <Border x:Name="PaneDivider" Grid.Column="2" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
            <Grid x:Name="SecondaryPane" Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="SecondaryPaneTitle" Content="오른쪽 창" HorizontalAlignment="Left"
                        AutomationProperties.Name="오른쪽 창 활성화" Click="OnActivateRight"
                        Margin="0,0,0,3"/>
                <TabView x:Name="RightTabs" Grid.Row="1" Height="45"
                         IsAddTabButtonVisible="False" CanDragTabs="False"
                         TabWidthMode="SizeToContent" SelectionChanged="OnRightTabSelectionChanged"
                         AutomationProperties.Name="오른쪽 폴더 탭"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5"
                            AutomationProperties.Name="오른쪽 파일 목록 열 조절">
                    <TextBlock Text="이름 열 너비" VerticalAlignment="Center"/>
                    <Slider x:Name="RightNameWidthSlider" Minimum="120" Maximum="320"
                            Value="168" StepFrequency="16" Width="92"
                            ValueChanged="OnNameColumnWidthChanged"
                            AutomationProperties.Name="오른쪽 이름 열 너비 조절"/>
                    <TextBlock Text="이름 | Windows 유형 | 크기 | 수정 날짜"
                               VerticalAlignment="Center" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ListView x:Name="RightFiles" Grid.Row="3" IsDoubleTapEnabled="True"
                          SelectionMode="Multiple" DoubleTapped="OnRightFileDoubleTapped"
                          KeyDown="OnRightFileKeyDown" RightTapped="OnFileRightTapped"
                          AllowDrop="True" CanDragItems="True" CanReorderItems="False"
                          DragOver="OnFileDragOver" Drop="OnFileDrop"
                          DragItemsStarting="OnFileDragItemsStarting"
                          AutomationProperties.Name="오른쪽 폴더 내용">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="복사" Click="OnCopySelected"/>
                            <MenuFlyoutItem Text="이동" Click="OnMoveSelected"/>
                            <MenuFlyoutItem Text="이름 변경" Click="OnRenameSelected"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Windows 클립보드로 복사"
                                Click="OnWindowsCopy"/>
                            <MenuFlyoutItem Text="Windows 클립보드로 잘라내기"
                                Click="OnWindowsCut"/>
                            <MenuFlyoutItem Text="Windows 클립보드에서 붙여넣기"
                                Click="OnWindowsPaste"/>
                            <MenuFlyoutItem Text="휴지통" Click="OnRecycleSelected"/>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>
            </Grid>
        </Grid>
        <local:StatusFooter x:Name="FooterView" Grid.Row="6"/>
    </Grid>
</Window>
