<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FlyExplorerWinUIShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="flyExplorer - WinUI 3 migration preview">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="14,12,14,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                <Button x:Name="BackButton" Content="&#x2190;" Height="38" MinWidth="42" ToolTipService.ToolTip="Back" Click="OnBackClicked"/>
                <Button x:Name="ForwardButton" Content="&#x2192;" Height="38" MinWidth="42" ToolTipService.ToolTip="Forward" Click="OnForwardClicked"/>
                <Button x:Name="UpButton" Content="&#x2191;" Height="38" MinWidth="42" ToolTipService.ToolTip="Parent folder" Click="OnUpClicked"/>
            </StackPanel>
            <TextBox x:Name="AddressBox" Grid.Column="1" Height="38"
                     PlaceholderText="Enter a local folder path" KeyDown="OnAddressKeyDown"
                     AutomationProperties.Name="Active folder address"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button x:Name="NewTabButton" Content="New tab" Height="38" Click="OnNewTabClicked"/>
                <Button x:Name="CloseTabButton" Content="Close tab" Height="38" Click="OnCloseTabClicked"/>
                <Button x:Name="SplitButton" Content="Single pane" Height="38" Click="OnSplitClicked"/>
                <Button x:Name="WorkspacePanelButton" Content="Workspaces" Height="38"
                        AutomationProperties.Name="Show named workspaces"
                        Click="OnToggleWorkspaces"/>
                <Button x:Name="SearchPanelButton" Content="Search" Height="38"
                        AutomationProperties.Name="Show filesystem search"
                        Click="OnToggleSearch"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" x:Name="WorkspacePanel" Visibility="Collapsed"
                    Orientation="Horizontal" Spacing="7" Padding="14,3,14,6">
            <TextBlock Text="Named workspace:" VerticalAlignment="Center"/>
            <TextBox x:Name="WorkspaceFileBox" Width="355"
                     PlaceholderText="Full .fxworkspace file path"
                     AutomationProperties.Name="Named workspace file path"/>
            <Button x:Name="SaveWorkspaceButton" Content="Save new"
                    Click="OnSaveWorkspace" AutomationProperties.Name="Save named workspace"/>
            <Button x:Name="OpenWorkspaceButton" Content="Open new window"
                    Click="OnOpenWorkspace" AutomationProperties.Name="Open named workspace in new window"/>
            <TextBlock Text="Never overwrites an existing file"
                       Opacity="0.65" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="2" x:Name="SearchPanel" Visibility="Collapsed"
                    Spacing="5" Padding="14,3,14,5">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBox x:Name="SearchScopeBox" Width="315"
                         PlaceholderText="Full search scope folder"
                         AutomationProperties.Name="Full search scope"/>
                <TextBox x:Name="SearchTermBox" Width="155"
                         PlaceholderText="Filename contains"
                         AutomationProperties.Name="Search filename query"/>
                <CheckBox x:Name="SearchRememberBox" IsChecked="False"
                          Content="Remember location (opt-in)"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Remember recent search location"/>
                <Button x:Name="SearchRunButton" Content="Find files"
                        Click="OnRunSearch" AutomationProperties.Name="Run filename search"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="Recent locations:" VerticalAlignment="Center"/>
                <TextBlock x:Name="RecentCountText" Text="0 saved" VerticalAlignment="Center"
                           AutomationProperties.Name="Count of recent search locations"/>
                <ComboBox x:Name="SearchRecentBox" Width="350"
                          PlaceholderText="Select previous opted-in location"
                          SelectionChanged="OnSelectSearchRecent"
                          AutomationProperties.Name="Recent search locations"/>
                <Button x:Name="SearchClearButton" Content="Clear recent"
                        Click="OnClearSearchRecent"
                        AutomationProperties.Name="Clear recent search locations"/>
                <TextBlock x:Name="SearchCountText" Text="Bounded filename search; no file mutations"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Search result summary"/>
            </StackPanel>
            <ListView x:Name="SearchMatches" Height="94"
                      AutomationProperties.Name="Matching file paths"/>
        </StackPanel>
        <Grid Grid.Row="3" Padding="10,0,10,0" ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition x:Name="SecondaryColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="Navigation" FontSize="15" FontWeight="SemiBold" Margin="6,9,0,8"/>
                    <Button x:Name="HomeButton" Content="Home" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OnHomeClicked" AutomationProperties.Name="Navigate to home folder"/>
                    <Button x:Name="DocumentsButton" Content="Documents" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Click="OnDocumentsClicked"/>
                    <Button x:Name="DownloadsButton" Content="Downloads" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Click="OnDownloadsClicked"/>
                    <TextBlock Text="Windows Shell namespace preview"
                               TextWrapping="Wrap" Opacity="0.60" FontSize="12" Margin="6,14,6,0"/>
                </StackPanel>
            </Border>
            <Grid x:Name="PrimaryPane" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="PrimaryPaneTitle" Content="Left pane" HorizontalAlignment="Left"
                        AutomationProperties.Name="Activate left pane" Click="OnActivateLeft"
                        Margin="0,0,0,3"/>
                <TabView x:Name="LeftTabs" Grid.Row="1" Height="45"
                         IsAddTabButtonVisible="False" CanDragTabs="False"
                         TabWidthMode="SizeToContent" SelectionChanged="OnLeftTabSelectionChanged"
                         AutomationProperties.Name="Left folder tabs"/>
                <ListView x:Name="LeftFiles" Grid.Row="2" IsDoubleTapEnabled="True"
                          SelectionMode="Single" DoubleTapped="OnLeftFileDoubleTapped"
                          KeyDown="OnLeftFileKeyDown"
                          AutomationProperties.Name="Left folder contents"/>
            </Grid>
            <Border x:Name="PaneDivider" Grid.Column="2" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
            <Grid x:Name="SecondaryPane" Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="SecondaryPaneTitle" Content="Right pane" HorizontalAlignment="Left"
                        AutomationProperties.Name="Activate right pane" Click="OnActivateRight"
                        Margin="0,0,0,3"/>
                <TabView x:Name="RightTabs" Grid.Row="1" Height="45"
                         IsAddTabButtonVisible="False" CanDragTabs="False"
                         TabWidthMode="SizeToContent" SelectionChanged="OnRightTabSelectionChanged"
                         AutomationProperties.Name="Right folder tabs"/>
                <ListView x:Name="RightFiles" Grid.Row="2" IsDoubleTapEnabled="True"
                          SelectionMode="Single" DoubleTapped="OnRightFileDoubleTapped"
                          KeyDown="OnRightFileKeyDown"
                          AutomationProperties.Name="Right folder contents"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="4" Padding="14,8,14,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActivePaneText" Text="Active: Left" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Explorer status"/>
        </Grid>
    </Grid>
</Window>
