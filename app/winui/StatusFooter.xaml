<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FlyExplorer.StatusFooter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Grid Padding="14,8,14,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActivePaneText" Text="활성: 왼쪽" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="준비됨"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="탐색기 상태"/>
        </Grid>
</UserControl>
