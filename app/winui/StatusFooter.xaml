<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FlyExplorer.StatusFooter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="24" Padding="10,3,10,4">
        <!-- Kept in the tree for existing UIA/state contracts; active-pane state
             is primarily indicated by the pane accent rather than status prose. -->
        <TextBlock x:Name="ActivePaneText" Text="활성: 왼쪽"
                   Width="1" Opacity="0" IsHitTestVisible="False"/>
        <TextBlock x:Name="StatusText" Text="준비됨"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" FontSize="11.5"
                   AutomationProperties.Name="탐색기 상태"/>
    </Grid>
</UserControl>
