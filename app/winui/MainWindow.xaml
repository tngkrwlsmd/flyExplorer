<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FlyExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlyExplorer"
    Title="flyExplorer">
    <Grid x:Name="RootShell"
          Background="Transparent"
          SizeChanged="OnShellSizeChanged">
    <Grid.Resources>
        <Style x:Key="ExplorerIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>
        <Style x:Key="ExplorerListItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>
        <Style x:Key="ExplorerColumnHeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>
        <Style x:Key="ExplorerColumnResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border Width="1"
                                    HorizontalAlignment="Right"
                                    Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                    Opacity="{ThemeResource FlyExplorerColumnSeparatorOpacity}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="ExplorerVerticalItemsPanel"><ItemsStackPanel Orientation="Vertical"/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ExplorerSmallIconsItemsPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="164" ItemHeight="34"/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ExplorerMediumIconsItemsPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="96"/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ExplorerLargeIconsItemsPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="120" ItemHeight="132"/></ItemsPanelTemplate>
        <Style x:Key="ExplorerPaneTitleStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:ShellHeader x:Name="HeaderView" Grid.Row="0"/>
        <local:FileToolbar x:Name="ToolbarView" Grid.Row="2"/>
        <Grid Grid.Row="1" Padding="10,3,10,3" ColumnSpacing="6"
              AutomationProperties.Name="&#xD0D0;&#xC0C9; &#xBC0F; &#xC8FC;&#xC18C; &#xD45C;&#xC2DC;&#xC904;">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                <Button x:Name="BackButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xB4A4;&#xB85C;" Click="OnBackClicked"
                        AutomationProperties.Name="&#xB4A4;&#xB85C;">
                    <FontIcon Glyph="&#xE72B;" FontSize="15"/>
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xC55E;&#xC73C;&#xB85C;" Click="OnForwardClicked"
                        AutomationProperties.Name="&#xC55E;&#xC73C;&#xB85C;">
                    <FontIcon Glyph="&#xE72A;" FontSize="15"/>
                </Button>
                <Button x:Name="UpButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xC0C1;&#xC704; &#xD3F4;&#xB354;" Click="OnUpClicked"
                        AutomationProperties.Name="&#xC0C1;&#xC704; &#xD3F4;&#xB354;">
                    <FontIcon Glyph="&#xE74A;" FontSize="15"/>
                </Button>
            </StackPanel>
            <Grid Grid.Column="1" Height="32">
                <TextBox x:Name="AddressBox" Height="32" Opacity="0"
                         PlaceholderText="&#xD3F4;&#xB354; &#xACBD;&#xB85C;&#xB97C; &#xC785;&#xB825;&#xD558;&#xC138;&#xC694;"
                         KeyDown="OnAddressKeyDown" GotFocus="OnAddressGotFocus"
                         LostFocus="OnAddressLostFocus"
                         AutomationProperties.Name="&#xD604;&#xC7AC; &#xD3F4;&#xB354; &#xC8FC;&#xC18C;"/>
                <Grid x:Name="AddressDisplayButton" Height="32">
                    <Border Background="Transparent" BorderThickness="1" CornerRadius="4"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
                    <Grid Margin="4,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center"/>
                        </ScrollViewer>
                        <Button x:Name="AddressEditButton" Grid.Column="1" Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4"
                                Click="OnAddressDisplayClicked" ToolTipService.ToolTip="&#xC8FC;&#xC18C; &#xD3B8;&#xC9D1;"
                                AutomationProperties.Name="&#xD604;&#xC7AC; &#xC704;&#xCE58; &#xC8FC;&#xC18C; &#xD3B8;&#xC9D1;">
                            <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
            <TextBox x:Name="QuickSearchBox" Grid.Column="2" Height="32"
                     PlaceholderText="&#xD604;&#xC7AC; &#xD3F4;&#xB354; &#xAC80;&#xC0C9;"
                     KeyDown="OnQuickSearchKeyDown"
                     AutomationProperties.Name="&#xD604;&#xC7AC; &#xD3F4;&#xB354; &#xAC80;&#xC0C9;&#xC5B4;"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                <Button x:Name="NewTabButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xC0C8; &#xD0ED;" Click="OnNewTabClicked"
                        AutomationProperties.Name="&#xC0C8; &#xD0ED;">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                </Button>
                <Button x:Name="CloseTabButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xD0ED; &#xB2EB;&#xAE30;" Click="OnCloseTabClicked"
                        AutomationProperties.Name="&#xD604;&#xC7AC; &#xD0ED; &#xB2EB;&#xAE30;">
                    <FontIcon Glyph="&#xE711;" FontSize="14"/>
                </Button>
                <Button x:Name="SplitButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xB4C0;&#xC5BC; &#xD328;&#xB110; &#xC804;&#xD658;"
                        Click="OnSplitClicked"
                        AutomationProperties.Name="&#xB4C0;&#xC5BC; &#xD328;&#xB110; &#xC804;&#xD658;">
                    <FontIcon Glyph="&#xE73F;" FontSize="14"/>
                </Button>
                <Button x:Name="WorkspacePanelButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xC791;&#xC5C5; &#xACF5;&#xAC04;"
                        AutomationProperties.Name="&#xC791;&#xC5C5; &#xACF5;&#xAC04; &#xC5F4;&#xAE30;"
                        Click="OnToggleWorkspaces">
                    <FontIcon Glyph="&#xE821;" FontSize="14"/>
                </Button>
                <Button x:Name="SearchPanelButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="&#xACE0;&#xAE09; &#xAC80;&#xC0C9;"
                        AutomationProperties.Name="&#xD30C;&#xC77C; &#xAC80;&#xC0C9; &#xC5F4;&#xAE30;"
                        Click="OnToggleSearch">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                </Button>
                <Button x:Name="FilterRulePanelButton" Style="{StaticResource ExplorerIconButtonStyle}"
                        ToolTipService.ToolTip="필터 프리셋"
                        AutomationProperties.Name="필터 프리셋 관리 열기"
                        Click="OnToggleFilterRules">
                    <FontIcon Glyph="&#xE71C;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" MinHeight="32" Padding="10,1,10,2" ColumnSpacing="4"
              AutomationProperties.Name="북마크 표시줄">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BookmarkButtonsPanel"
                            Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="저장된 북마크"/>
            </ScrollViewer>
            <Button x:Name="AddBookmarkButton" Grid.Column="1"
                    Style="{StaticResource ExplorerIconButtonStyle}"
                    ToolTipService.ToolTip="현재 폴더를 북마크에 추가"
                    AutomationProperties.Name="현재 폴더 북마크 추가"
                    Click="OnAddBookmark">
                <FontIcon Glyph="&#xE734;" FontSize="13"/>
            </Button>
            <Button x:Name="BookmarkManagerButton" Grid.Column="2"
                    Style="{StaticResource ExplorerIconButtonStyle}"
                    ToolTipService.ToolTip="북마크 관리"
                    AutomationProperties.Name="북마크 관리 열기"
                    Click="OnToggleBookmarks">
                <FontIcon Glyph="&#xE713;" FontSize="13"/>
            </Button>
        </Grid>
        <StackPanel Grid.Row="4" x:Name="BookmarkPanel" Visibility="Collapsed"
                    Spacing="6" Padding="14,3,14,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <ComboBox x:Name="BookmarkManagerBox" Width="230"
                          PlaceholderText="북마크 선택"
                          SelectionChanged="OnBookmarkSelectionChanged"
                          AutomationProperties.Name="관리할 북마크"/>
                <TextBox x:Name="BookmarkNameEdit" Width="220" MaxLength="256"
                         PlaceholderText="북마크 이름"
                         AutomationProperties.Name="북마크 이름"/>
                <Button x:Name="BookmarkRenameButton" Content="이름 변경"
                        Click="OnRenameBookmark"
                        AutomationProperties.Name="선택한 북마크 이름 변경"/>
                <Button x:Name="BookmarkDeleteButton" Content="삭제"
                        Click="OnDeleteBookmark"
                        AutomationProperties.Name="선택한 북마크 삭제"/>
                <TextBlock x:Name="BookmarkSelectedPathText"
                           MaxWidth="360" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Opacity="{ThemeResource FlyExplorerSubtleTextOpacity}"
                           AutomationProperties.Name="선택한 북마크 경로"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBox x:Name="BookmarkImportPathBox" Width="520"
                         PlaceholderText="기존 flyExplorer 북마크 파일 전체 경로"
                         AutomationProperties.Name="가져올 기존 북마크 파일 경로"/>
                <Button x:Name="BookmarkImportButton" Content="기존 북마크 가져오기"
                        Click="OnImportBookmarks"
                        AutomationProperties.Name="기존 flyExplorer 북마크 가져오기"/>
                <TextBlock Text="기존 프로필은 자동으로 읽지 않습니다"
                           VerticalAlignment="Center" Opacity="{ThemeResource FlyExplorerSubtleTextOpacity}"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="4" x:Name="FilterRulePanel" Visibility="Collapsed"
                    Spacing="6" Padding="14,3,14,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="필터 프리셋:" VerticalAlignment="Center"/>
                <ComboBox x:Name="FilterRuleManagerBox" Width="200"
                          PlaceholderText="저장된 규칙 선택"
                          SelectionChanged="OnFilterRuleSelectionChanged"
                          AutomationProperties.Name="저장된 필터 프리셋"/>
                <TextBox x:Name="FilterRuleNameEdit" Width="190" MaxLength="56"
                         PlaceholderText="규칙 이름"
                         AutomationProperties.Name="필터 프리셋 이름"/>
                <Button x:Name="FilterRuleNewButton" Content="새 규칙"
                        Click="OnNewFilterRule"
                        AutomationProperties.Name="새 필터 프리셋 작성"/>
                <Button x:Name="FilterRuleSaveButton" Content="저장"
                        Click="OnSaveFilterRule"
                        AutomationProperties.Name="필터 프리셋 저장"/>
                <Button x:Name="FilterRuleDeleteButton" Content="삭제"
                        Click="OnDeleteFilterRule"
                        AutomationProperties.Name="선택한 필터 프리셋 삭제"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBox x:Name="FilterRuleMasksEdit" Width="430" MaxLength="260"
                         PlaceholderText="예: *.cpp;*.h 또는 이름 일부"
                         AutomationProperties.Name="필터 이름 또는 마스크 규칙"/>
                <Button x:Name="FilterRuleApplyButton" Content="활성 창에 적용"
                        Click="OnApplyFilterRule"
                        AutomationProperties.Name="현재 활성 창에 필터 프리셋 적용"/>
                <TextBlock Text="* ? ;가 있으면 마스크 집합, 없으면 기존 이름 포함 필터"
                           VerticalAlignment="Center" Opacity="{ThemeResource FlyExplorerSubtleTextOpacity}"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="5" x:Name="WorkspacePanel" Visibility="Collapsed"
                    Orientation="Vertical" Spacing="7" Padding="14,3,14,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="이름 있는 작업 공간:" VerticalAlignment="Center"/>
                <TextBox x:Name="WorkspaceFileBox" Width="355"
                         PlaceholderText=".fxworkspace 파일 전체 경로"
                         AutomationProperties.Name="작업 공간 파일 경로"/>
                <Button x:Uid="SaveWorkspaceButton" x:Name="SaveWorkspaceButton" Content="새로 저장"
                        Click="OnSaveWorkspace" AutomationProperties.Name="새 작업 공간 저장"/>
                <Button x:Uid="OpenWorkspaceButton" x:Name="OpenWorkspaceButton" Content="새 창에서 열기"
                        Click="OnOpenWorkspace" AutomationProperties.Name="작업 공간을 새 창에서 열기"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Button x:Uid="SaveSessionAction" x:Name="SaveSessionButton" Content="현재 세션 기억"
                        Click="OnSavePrivateSession"
                        AutomationProperties.Name="현재 폴더 탭 및 화면 설정을 개인 프로필에 저장"/>
                <Button x:Uid="RestoreSessionAction" x:Name="RestoreSessionButton" Content="저장된 세션 복원"
                        Click="OnRestorePrivateSession"
                        AutomationProperties.Name="저장된 개인 탐색 세션 불러오기"/>
                <Button x:Uid="ClearSessionAction" x:Name="ClearSessionButton" Content="기억 삭제"
                        Click="OnClearPrivateSession"
                        AutomationProperties.Name="저장된 개인 탐색 세션 지우기"/>
                <TextBlock Text="기존 파일은 덮어쓰지 않습니다"
                           Opacity="{ThemeResource FlyExplorerSubtleTextOpacity}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="6" x:Name="SearchPanel" Visibility="Collapsed"
                    Spacing="5" Padding="14,3,14,5">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBox x:Name="SearchScopeBox" Width="315"
                         PlaceholderText="검색할 폴더의 전체 경로"
                         AutomationProperties.Name="검색 폴더 전체 경로"/>
                <TextBox x:Name="SearchTermBox" Width="210" MaxLength="256"
                         PlaceholderText="이름 검색어 또는 정규식"
                         AutomationProperties.Name="검색어 또는 정규식"/>
                <CheckBox x:Name="SearchRememberBox" IsChecked="False"
                          Content="검색 위치 기억(선택)"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="최근 검색 위치 저장 선택"/>
                <Button x:Uid="SearchRunButton" x:Name="SearchRunButton" Content="파일 찾기"
                        Click="OnRunSearch" AutomationProperties.Name="이름 조건 검색 실행"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="검색 방식:" VerticalAlignment="Center"/>
                <ComboBox x:Name="SearchModeBox" Width="185" SelectedIndex="0"
                          AutomationProperties.Name="검색 방식">
                    <ComboBoxItem Content="직접 탐색 (기존)"/>
                    <ComboBoxItem Content="Windows 검색 인덱스"/>
                </ComboBox>
                <TextBlock Text="인덱스: 파일명·확장자·크기·수정일 · 1,000개 · 미인덱싱 제외"
                           VerticalAlignment="Center" Opacity="{ThemeResource FlyExplorerSubtleTextOpacity}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <CheckBox x:Name="SearchRegexBox" IsChecked="False"
                          Content="정규식"
                          AutomationProperties.Name="정규식 검색 사용"/>
                <CheckBox x:Name="SearchCaseBox" IsChecked="False"
                          Content="대/소문자 구분 (이름/내용)"
                          AutomationProperties.Name="대소문자 구분"/>
                <TextBlock Text="대상:" VerticalAlignment="Center"/>
                <ComboBox x:Name="SearchTargetBox" Width="125" SelectedIndex="0"
                          AutomationProperties.Name="검색 대상">
                    <ComboBoxItem Content="파일"/>
                    <ComboBoxItem Content="폴더"/>
                    <ComboBoxItem Content="파일 + 폴더"/>
                </ComboBox>
                <TextBox x:Name="SearchExtensionBox" Width="135" MaxLength="32"
                         PlaceholderText="확장자 예: .txt"
                         AutomationProperties.Name="파일 확장자 조건"/>
                <TextBlock Text="깊이 32 · 최대 20,000개 검사 · 결과 1,000개"
                           VerticalAlignment="Center" Opacity="{ThemeResource FlyExplorerSubtleTextOpacity}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="파일 내용:" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchContentBox" Width="245" MaxLength="256"
                         PlaceholderText="파일 내용 일반 텍스트 또는 정규식"
                         AutomationProperties.Name="파일 내용 검색어"/>
                <CheckBox x:Name="SearchContentRegexBox" IsChecked="False"
                          Content="내용 정규식"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="파일 내용 정규식 사용"/>
                <TextBlock Text="인코딩:" VerticalAlignment="Center"/>
                <ComboBox x:Name="SearchContentEncodingBox" Width="155" SelectedIndex="0"
                          AutomationProperties.Name="파일 내용 인코딩">
                    <ComboBoxItem Content="자동 UTF"/>
                    <ComboBoxItem Content="한국어 CP949"/>
                    <ComboBoxItem Content="서유럽 Windows-1252"/>
                </ComboBox>
                <TextBlock Text="BOM 우선 · 1 MiB/파일 · 16 MiB/검색"
                           VerticalAlignment="Center" Opacity="{ThemeResource FlyExplorerSubtleTextOpacity}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="크기(KB):" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchMinSizeBox" Width="90" MaxLength="20"
                         PlaceholderText="최소"
                         AutomationProperties.Name="최소 파일 크기 KB"/>
                <TextBlock Text="~" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchMaxSizeBox" Width="90" MaxLength="20"
                         PlaceholderText="최대"
                         AutomationProperties.Name="최대 파일 크기 KB"/>
                <TextBlock Text="수정일:" VerticalAlignment="Center"/>
                <TextBlock Text="이후:" VerticalAlignment="Center" Opacity="{ThemeResource FlyExplorerSecondaryTextOpacity}"/>
                <TextBox x:Name="SearchModifiedAfterBox" Width="108" MaxLength="10"
                         PlaceholderText="YYYY-MM-DD"
                         AutomationProperties.Name="수정일 이후"/>
                <TextBlock Text="~ 이전:" VerticalAlignment="Center" Opacity="{ThemeResource FlyExplorerSecondaryTextOpacity}"/>
                <TextBox x:Name="SearchModifiedBeforeBox" Width="108" MaxLength="10"
                         PlaceholderText="YYYY-MM-DD"
                         AutomationProperties.Name="수정일 이전"/>
                <TextBlock Text="범위 포함" VerticalAlignment="Center" Opacity="{ThemeResource FlyExplorerSubtleTextOpacity}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="조건 세트:" VerticalAlignment="Center"/>
                <ComboBox x:Name="SearchPresetBox" Width="185"
                          PlaceholderText="저장된 조건 선택"
                          SelectionChanged="OnSearchPresetSelectionChanged"
                          AutomationProperties.Name="저장된 검색 조건 세트"/>
                <TextBox x:Name="SearchPresetNameBox" Width="165" MaxLength="56"
                         PlaceholderText="조건 세트 이름"
                         AutomationProperties.Name="검색 조건 세트 이름"/>
                <Button x:Name="SearchPresetNewButton" Content="새 조건"
                        Click="OnNewSearchPreset"
                        AutomationProperties.Name="새 검색 조건 세트"/>
                <Button x:Name="SearchPresetSaveButton" Content="저장"
                        Click="OnSaveSearchPreset"
                        AutomationProperties.Name="검색 조건 세트 저장"/>
                <Button x:Name="SearchPresetApplyButton" Content="적용"
                        Click="OnApplySearchPreset"
                        AutomationProperties.Name="검색 조건 세트 적용"/>
                <Button x:Name="SearchPresetDeleteButton" Content="삭제"
                        Click="OnDeleteSearchPreset"
                        AutomationProperties.Name="검색 조건 세트 삭제"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="최근 검색 위치:" VerticalAlignment="Center"/>
                <TextBlock x:Name="RecentCountText" Text="저장 0개" VerticalAlignment="Center"
                           AutomationProperties.Name="최근 검색 위치 수"/>
                <ComboBox x:Name="SearchRecentBox" Width="350"
                          PlaceholderText="저장된 검색 위치 선택"
                          SelectionChanged="OnSelectSearchRecent"
                          AutomationProperties.Name="최근 검색 위치"/>
                <Button x:Uid="SearchClearButton" x:Name="SearchClearButton" Content="최근 기록 지우기"
                        Click="OnClearSearchRecent"
