<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FlyExplorer.ShellHeader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="TitleBarRoot" Height="38" Padding="10,0,154,0"
          Background="Transparent" ColumnSpacing="8"
          AutomationProperties.Name="flyExplorer 제목 표시줄">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8B7;" FontSize="14" AutomationProperties.Name="flyExplorer"/>
            <TextBlock x:Name="ShellHeading" Text="flyExplorer"
                       FontSize="12.5" FontWeight="Normal" Opacity="0.90" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid x:Name="TitleBarDragRegion" Grid.Column="1"
              Background="Transparent">
            <TextBlock Text="파일 탐색기"
                       VerticalAlignment="Center" Opacity="0.32" FontSize="11.5"/>
        </Grid>

        <!-- Retained for persisted theme/UIA compatibility. Theme selection is
             exposed from the command-bar More menu, not ordinary title chrome. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Width="1"
                    Opacity="0" IsHitTestVisible="False"
                    VerticalAlignment="Center">
            <TextBlock x:Name="ThemeStateText" Text="테마: 시스템"
                       AutomationProperties.Name="현재 화면 테마"/>
            <ComboBox x:Name="ThemePicker" Width="1" Height="1"
                      IsTabStop="False" SelectedIndex="0"
                      SelectionChanged="OnThemeSelectionChanged"
                      AutomationProperties.Name="화면 테마 선택">
                <ComboBoxItem Content="시스템"/>
                <ComboBoxItem Content="라이트"/>
                <ComboBoxItem Content="다크"/>
            </ComboBox>
        </StackPanel>
        <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                Opacity="0.38"/>
    </Grid>
</UserControl>
