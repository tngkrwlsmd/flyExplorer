#include <windows.h>
#include "product_version.h"

IDI_FLYEXPLORER_ICON ICON "Assets\\flyExplorer.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FLYEXPLORER_VERSION_COMMA
 PRODUCTVERSION FLYEXPLORER_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", FLYEXPLORER_COMPANY_NAME "\0"
            VALUE "FileDescription", FLYEXPLORER_FILE_DESCRIPTION "\0"
            VALUE "FileVersion", FLYEXPLORER_VERSION_STRING "\0"
            VALUE "InternalName", FLYEXPLORER_INTERNAL_NAME "\0"
            VALUE "LegalCopyright", FLYEXPLORER_LEGAL_COPYRIGHT "\0"
            VALUE "OriginalFilename", FLYEXPLORER_ORIGINAL_FILENAME "\0"
            VALUE "ProductName", FLYEXPLORER_PRODUCT_NAME "\0"
            VALUE "ProductVersion", FLYEXPLORER_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
