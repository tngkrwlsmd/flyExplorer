<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FlyExplorer.FileToolbar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ExplorerCommandButtonStyle" TargetType="AppBarButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MaxWidth" Value="36"/>
            <Setter Property="Height" Value="36"/>
        </Style>
    </UserControl.Resources>
    <Grid Height="42" Padding="10,0,10,1" ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <CommandBar x:Name="ExplorerCommandBar" Grid.Column="0" Height="40" MinHeight="40"
                    VerticalAlignment="Top" Background="Transparent" DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="True"
                    AutomationProperties.Name="파일 작업 명령 모음">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="CreateFolderButton" Style="{StaticResource ExplorerCommandButtonStyle}"
                              Label="새로 만들기" ToolTipService.ToolTip="새 폴더"
                              Click="OnCreateFolder"
                              AutomationProperties.Name="현재 폴더에 새 폴더 만들기">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Name="WindowsCutButton" Style="{StaticResource ExplorerCommandButtonStyle}"
                              Label="잘라내기" ToolTipService.ToolTip="잘라내기"
                              Click="OnWindowsCut">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C6;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="WindowsCopyButton" Style="{StaticResource ExplorerCommandButtonStyle}"
                              Label="복사" ToolTipService.ToolTip="복사"
                              Click="OnWindowsCopy">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="WindowsPasteButton" Style="{StaticResource ExplorerCommandButtonStyle}"
                              Label="붙여넣기" ToolTipService.ToolTip="붙여넣기"
                              Click="OnWindowsPaste">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE77F;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Name="RenameButton" Style="{StaticResource ExplorerCommandButtonStyle}"
                              Label="이름 바꾸기" ToolTipService.ToolTip="이름 바꾸기"
                              Click="OnRenameSelected"
                              AutomationProperties.Name="선택된 파일 또는 폴더 이름 변경">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8AC;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="RecycleButton" Style="{StaticResource ExplorerCommandButtonStyle}"
                              Label="삭제" ToolTipService.ToolTip="휴지통으로 보내기"
                              Click="OnRecycle"
                              AutomationProperties.Name="선택한 항목을 확인 후 휴지통으로 보내기">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Name="CopyButton" Style="{StaticResource ExplorerCommandButtonStyle}"
                              Label="반대쪽으로 복사" ToolTipService.ToolTip="반대쪽 창으로 복사"
                              Click="OnCopy"
                              AutomationProperties.Name="선택한 항목을 반대쪽 창으로 복사">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="MoveButton" Style="{StaticResource ExplorerCommandButtonStyle}"
                              Label="반대쪽으로 이동" ToolTipService.ToolTip="반대쪽 창으로 이동"
                              Click="OnMove"
                              AutomationProperties.Name="선택한 항목을 반대쪽 창으로 이동">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8DE;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="CancelButton" Style="{StaticResource ExplorerCommandButtonStyle}"
                              Label="취소" ToolTipService.ToolTip="파일 작업 취소"
                              Click="OnCancel" IsEnabled="False"
                              AutomationProperties.Name="진행 중인 파일 작업 취소">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE711;"/></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <!-- Kept in the visual tree for UIA/IME contracts, but only expands after
             Create/Rename is invoked. It must not consume ordinary command chrome. -->
        <TextBox x:Name="FileNameBox" Grid.Column="1" Width="1" MinWidth="0" Height="32"
                 Opacity="0" IsHitTestVisible="False" IsTabStop="False"
                 VerticalAlignment="Center" KeyDown="OnNameKeyDown"
                 PlaceholderText="새 이름을 입력하세요"
                 AutomationProperties.Name="새 폴더 또는 새 파일 이름"/>

        <ComboBox x:Name="SortPicker" Grid.Column="2" Width="106" Height="32"
                  SelectedIndex="0" SelectionChanged="OnSortChanged"
                  AutomationProperties.Name="현재 창 파일 정렬 방식">
            <ComboBoxItem Content="이름 ↑"/>
            <ComboBoxItem Content="이름 ↓"/>
            <ComboBoxItem Content="크기 ↓"/>
            <ComboBoxItem Content="수정 날짜 ↓"/>
        </ComboBox>

        <Button x:Name="MoreButton" Grid.Column="3" Width="32" Height="32"
                Padding="0" Background="Transparent"
                ToolTipService.ToolTip="더 보기"
                AutomationProperties.Name="더 보기">
            <FontIcon Glyph="&#xE712;" FontSize="16"/>
            <Button.Flyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="왼쪽 이름 필터" Click="OnToggleLeftFilter"/>
                    <MenuFlyoutItem Text="오른쪽 이름 필터" Click="OnToggleRightFilter"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutSubItem Text="테마">
                        <MenuFlyoutItem Text="시스템" Click="OnThemeSystem"/>
                        <MenuFlyoutItem Text="라이트" Click="OnThemeLight"/>
                        <MenuFlyoutItem Text="다크" Click="OnThemeDark"/>
                    </MenuFlyoutSubItem>
                </MenuFlyout>
            </Button.Flyout>
        </Button>

        <ProgressBar x:Name="OperationProgress" Grid.Column="4" Width="56"
                     Height="3" Minimum="0" Maximum="100" Value="0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="파일 작업 진행률"/>

        <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom"
                Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                Opacity="0.38"/>
    </Grid>
</UserControl>
