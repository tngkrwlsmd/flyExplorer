<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FlyExplorer.FileToolbar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ExplorerCommandButtonStyle" TargetType="AppBarButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MaxWidth" Value="44"/>
            <Setter Property="Height" Value="44"/>
        </Style>
    </UserControl.Resources>
    <Grid Padding="12,2,12,4" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="112"/>
            <ColumnDefinition Width="86"/>
        </Grid.ColumnDefinitions>
        <CommandBar x:Name="ExplorerCommandBar" Grid.Column="0"
                    Background="Transparent" DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="True"
                    AutomationProperties.Name="&#xD30C;&#xC77C; &#xC791;&#xC5C5; &#xBA85;&#xB839; &#xBAA8;&#xC74C;">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="CreateFolderButton" Style="{StaticResource ExplorerCommandButtonStyle}" Label="&#xC0C8; &#xD3F4;&#xB354;"
                              ToolTipService.ToolTip="&#xC0C8; &#xD3F4;&#xB354;"
                              Click="OnCreateFolder"
                              AutomationProperties.Name="&#xD604;&#xC7AC; &#xD3F4;&#xB354;&#xC5D0; &#xC0C8; &#xD3F4;&#xB354; &#xB9CC;&#xB4E4;&#xAE30;">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="RenameButton" Style="{StaticResource ExplorerCommandButtonStyle}" Label="&#xC774;&#xB984; &#xBCC0;&#xACBD;"
                              ToolTipService.ToolTip="&#xC774;&#xB984; &#xBCC0;&#xACBD;"
                              Click="OnRenameSelected"
                              AutomationProperties.Name="&#xC120;&#xD0DD;&#xB41C; &#xD30C;&#xC77C; &#xB610;&#xB294; &#xD3F4;&#xB354; &#xC774;&#xB984; &#xBCC0;&#xACBD;">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8AC;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Name="WindowsCutButton" Style="{StaticResource ExplorerCommandButtonStyle}" Label="&#xC798;&#xB77C;&#xB0B4;&#xAE30;"
                              ToolTipService.ToolTip="Windows &#xD074;&#xB9BD;&#xBCF4;&#xB4DC;&#xB85C; &#xC798;&#xB77C;&#xB0B4;&#xAE30;"
                              Click="OnWindowsCut">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C6;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="WindowsCopyButton" Style="{StaticResource ExplorerCommandButtonStyle}" Label="&#xBCF5;&#xC0AC;"
                              ToolTipService.ToolTip="Windows &#xD074;&#xB9BD;&#xBCF4;&#xB4DC;&#xB85C; &#xBCF5;&#xC0AC;"
                              Click="OnWindowsCopy">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="WindowsPasteButton" Style="{StaticResource ExplorerCommandButtonStyle}" Label="&#xBD99;&#xC5EC;&#xB123;&#xAE30;"
                              ToolTipService.ToolTip="Windows &#xD074;&#xB9BD;&#xBCF4;&#xB4DC;&#xC5D0;&#xC11C; &#xBD99;&#xC5EC;&#xB123;&#xAE30;"
                              Click="OnWindowsPaste">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE77F;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator/>
                <AppBarButton x:Name="CopyButton" Style="{StaticResource ExplorerCommandButtonStyle}" Label="&#xBCF5;&#xC0AC;"
                              ToolTipService.ToolTip="&#xBC18;&#xB300;&#xCABD; &#xCC3D;&#xC73C;&#xB85C; &#xBCF5;&#xC0AC;"
                              Click="OnCopy"
                              AutomationProperties.Name="&#xC120;&#xD0DD;&#xD55C; &#xD56D;&#xBAA9;&#xC744; &#xBC18;&#xB300;&#xCABD; &#xCC3D;&#xC73C;&#xB85C; &#xBCF5;&#xC0AC;">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="MoveButton" Style="{StaticResource ExplorerCommandButtonStyle}" Label="&#xC774;&#xB3D9;"
                              ToolTipService.ToolTip="&#xBC18;&#xB300;&#xCABD; &#xCC3D;&#xC73C;&#xB85C; &#xC774;&#xB3D9;"
                              Click="OnMove"
                              AutomationProperties.Name="&#xC120;&#xD0DD;&#xD55C; &#xD56D;&#xBAA9;&#xC744; &#xBC18;&#xB300;&#xCABD; &#xCC3D;&#xC73C;&#xB85C; &#xC774;&#xB3D9;">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8DE;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="RecycleButton" Style="{StaticResource ExplorerCommandButtonStyle}" Label="&#xD734;&#xC9C0;&#xD1B5;"
                              ToolTipService.ToolTip="&#xD734;&#xC9C0;&#xD1B5;&#xC73C;&#xB85C; &#xBCF4;&#xB0B4;&#xAE30;"
                              Click="OnRecycle"
                              AutomationProperties.Name="&#xC120;&#xD0DD;&#xD55C; &#xD56D;&#xBAA9;&#xC744; &#xD655;&#xC778; &#xD6C4; &#xD734;&#xC9C0;&#xD1B5;&#xC73C;&#xB85C; &#xBCF4;&#xB0B4;&#xAE30;">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="CancelButton" Style="{StaticResource ExplorerCommandButtonStyle}" Label="&#xCDE8;&#xC18C;"
                              ToolTipService.ToolTip="&#xD30C;&#xC77C; &#xC791;&#xC5C5; &#xCDE8;&#xC18C;"
                              Click="OnCancel" IsEnabled="False"
                              AutomationProperties.Name="&#xC9C4;&#xD589; &#xC911;&#xC778; Shell &#xD30C;&#xC77C; &#xC791;&#xC5C5; &#xCDE8;&#xC18C;">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE711;"/></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
        <TextBox x:Name="FileNameBox" Grid.Column="1" Width="145" Height="34"
                 VerticalAlignment="Center"
                 PlaceholderText="&#xC0C8; &#xC774;&#xB984;&#xC744; &#xC785;&#xB825;&#xD558;&#xC138;&#xC694;"
                 ToolTipService.ToolTip="&#xC0C8; &#xD3F4;&#xB354; &#xC774;&#xB984; &#xB610;&#xB294; &#xC774;&#xB984; &#xBCC0;&#xACBD;&#xD560; &#xC0C8; &#xC774;&#xB984;"
                 AutomationProperties.Name="&#xC0C8; &#xD3F4;&#xB354; &#xB610;&#xB294; &#xC0C8; &#xD30C;&#xC77C; &#xC774;&#xB984;"/>
        <ComboBox x:Name="SortPicker" Grid.Column="2" Height="34"
                  SelectedIndex="0" SelectionChanged="OnSortChanged"
                  AutomationProperties.Name="&#xD604;&#xC7AC; &#xCC3D; &#xD30C;&#xC77C; &#xC815;&#xB82C; &#xBC29;&#xC2DD;">
            <ComboBoxItem Content="&#xC774;&#xB984; &#x2191;"/>
            <ComboBoxItem Content="&#xC774;&#xB984; &#x2193;"/>
            <ComboBoxItem Content="&#xD06C;&#xAE30; &#x2193;"/>
            <ComboBoxItem Content="&#xC218;&#xC815; &#xB0A0;&#xC9DC; &#x2193;"/>
        </ComboBox>
        <ProgressBar x:Name="OperationProgress" Grid.Column="3" Width="80"
                     Height="4" Minimum="0" Maximum="100" Value="0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="&#xD30C;&#xC77C; &#xC791;&#xC5C5; &#xC9C4;&#xD589;&#xB960;"/>
        <Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom"
                Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                Opacity="0.55"/>
    </Grid>
</UserControl>
