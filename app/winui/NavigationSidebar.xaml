<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FlyExplorer.NavigationSidebar"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ExplorerNavButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>
    <Border Background="Transparent" BorderThickness="0" Padding="4,3,5,3">
        <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="1">
                <TextBlock Text="탐색" FontSize="11.5" FontWeight="SemiBold"
                           Opacity="{ThemeResource FlyExplorerSidebarHeadingOpacity}" Margin="7,4,0,5"/>
                <Button x:Name="HomeButton" Style="{StaticResource ExplorerNavButtonStyle}"
                        Click="OnHomeClicked" AutomationProperties.Name="홈으로 이동">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE80F;" FontSize="15"/>
                        <TextBlock Text="홈" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ThisPCButton" Style="{StaticResource ExplorerNavButtonStyle}"
                        Click="OnThisPCClicked" AutomationProperties.Name="내 PC로 이동">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE7F8;" FontSize="15"/>
                        <TextBlock Text="내 PC" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Rectangle Height="1" Margin="6,5"
                           Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
                <Button x:Name="DesktopButton" Style="{StaticResource ExplorerNavButtonStyle}"
                        Click="OnDesktopClicked" AutomationProperties.Name="바탕 화면으로 이동">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Grid Width="16" Height="16">
                            <FontIcon x:Name="DesktopFallbackIcon" Glyph="&#xE7F4;" FontSize="15"/>
                            <Image x:Name="DesktopArtwork" Width="16" Height="16" Visibility="Collapsed" Stretch="Uniform" AutomationProperties.Name="Windows Known Folder sidebar artwork: Desktop"/>
                        </Grid>
                        <TextBlock Text="바탕 화면" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DownloadsButton" Style="{StaticResource ExplorerNavButtonStyle}"
                        Click="OnDownloadsClicked" AutomationProperties.Name="다운로드로 이동">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Grid Width="16" Height="16">
                            <FontIcon x:Name="DownloadsFallbackIcon" Glyph="&#xE896;" FontSize="15"/>
                            <Image x:Name="DownloadsArtwork" Width="16" Height="16" Visibility="Collapsed" Stretch="Uniform" AutomationProperties.Name="Windows Known Folder sidebar artwork: Downloads"/>
                        </Grid>
                        <TextBlock Text="다운로드" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DocumentsButton" Style="{StaticResource ExplorerNavButtonStyle}"
                        Click="OnDocumentsClicked" AutomationProperties.Name="문서로 이동">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Grid Width="16" Height="16">
                            <FontIcon x:Name="DocumentsFallbackIcon" Glyph="&#xE8A5;" FontSize="15"/>
                            <Image x:Name="DocumentsArtwork" Width="16" Height="16" Visibility="Collapsed" Stretch="Uniform" AutomationProperties.Name="Windows Known Folder sidebar artwork: Documents"/>
                        </Grid>
                        <TextBlock Text="문서" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PicturesButton" Style="{StaticResource ExplorerNavButtonStyle}"
                        Click="OnPicturesClicked" AutomationProperties.Name="사진으로 이동">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Grid Width="16" Height="16">
                            <FontIcon x:Name="PicturesFallbackIcon" Glyph="&#xEB9F;" FontSize="15"/>
                            <Image x:Name="PicturesArtwork" Width="16" Height="16" Visibility="Collapsed" Stretch="Uniform" AutomationProperties.Name="Windows Known Folder sidebar artwork: Pictures"/>
                        </Grid>
                        <TextBlock Text="사진" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="MusicButton" Style="{StaticResource ExplorerNavButtonStyle}"
                        Click="OnMusicClicked" AutomationProperties.Name="음악으로 이동">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Grid Width="16" Height="16">
                            <FontIcon x:Name="MusicFallbackIcon" Glyph="&#xE8D6;" FontSize="15"/>
                            <Image x:Name="MusicArtwork" Width="16" Height="16" Visibility="Collapsed" Stretch="Uniform" AutomationProperties.Name="Windows Known Folder sidebar artwork: Music"/>
                        </Grid>
                        <TextBlock Text="음악" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="FolderTreeToggle" Style="{StaticResource ExplorerNavButtonStyle}"
                        Click="OnFolderTreeToggleClicked" AutomationProperties.Name="폴더 트리 표시"
                        Content="폴더 트리 펼치기"/>
                <StackPanel x:Name="FolderTreePanel" Visibility="Collapsed" Spacing="3" Margin="2,0,2,4">
                    <TreeView x:Name="FolderTreeView" Height="238" SelectionMode="Single"
                              Expanding="OnTreeExpanding" Collapsed="OnTreeCollapsed"
                              SelectionChanged="OnTreeSelectionChanged"
                              AutomationProperties.Name="현재 폴더의 하위 폴더 트리"/>
                    <TextBlock x:Name="FolderTreeStatus" Text="" Margin="7,0,2,3"
                               TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
                <Button x:Name="VideosButton" Style="{StaticResource ExplorerNavButtonStyle}"
                        Click="OnVideosClicked" AutomationProperties.Name="동영상으로 이동">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Grid Width="16" Height="16">
                            <FontIcon x:Name="VideosFallbackIcon" Glyph="&#xE8B2;" FontSize="15"/>
                            <Image x:Name="VideosArtwork" Width="16" Height="16" Visibility="Collapsed" Stretch="Uniform" AutomationProperties.Name="Windows Known Folder sidebar artwork: Videos"/>
                        </Grid>
                        <TextBlock Text="동영상" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
