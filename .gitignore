# Generated Visual Studio / GYP project files
*.sln
*.vcproj
*.vcproj.*
*.vcxproj
*.vcxproj.*
*.suo
*.user
*.ncb
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
.vs/
ipch/

# Build outputs and intermediates
/bin/
/obj/

# Local generated/downloaded tooling; canonical tools/winui is tracked
/tools/gyp-next/
/tools/logs/

# Distribution staging and generated packages
/dist/bin/
/dist/.package-stage/
/dist/.package-backup/
/dist/fxfile_v*.exe
/dist/fxfile_v*_portable.zip
/dist/SHA256SUMS.txt

# Compiled help and temporary, reproducible HTML Help Workshop staging
/dist/fxfile.chm
/dist/.htmlhelp-build/

# Local CI and developer logs
/logs/*
!/logs/.gitkeep

# Python bytecode, analysis/test caches, and local virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/

# Visual Studio / MSBuild additional intermediates
*.obj
*.pch
*.ipch
*.pdb
*.ilk
*.idb
*.tlog/
*.lastbuildstate
*.aps
*.VC.db-*

# Local developer logs, editor swap files, and OS metadata
*.log
*.tmp
*.swp
*.swo
*~
.idea/
.DS_Store
Thumbs.db
/out/
/.cache/
